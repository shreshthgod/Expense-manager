# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/expense_manager?schema=public"

# Secret used to sign session tokens (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"

# OpenAI-compatible AI provider (optional — app is fully functional without it).
# Works with OpenAI, Groq, OpenRouter, Ollama, or any compatible endpoint.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Public URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bearer token for POST /api/cron/run (scheduled work). Required in production.
CRON_SECRET="replace-with-another-long-random-secret"

# Number of reverse proxies in front of the app (0 = direct). Used for client IPs in rate limits.
TRUSTED_PROXY_HOPS=0

# "memory" (default, per instance) or "database" (shared across instances).
RATE_LIMIT_STORE=memory

# Disposable database for integration tests — WIPED on every test run.
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/expense_manager_test?schema=public"

# Allow `npm run db:seed` (demo user only) when NODE_ENV=production.
ALLOW_DEMO_SEED=false
